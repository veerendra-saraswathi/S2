{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s2:contract:telemetry:v1:message",
  "title": "S2 telemetry message, v1",
  "description": "The JSON payload published on s2/v1/{tenant_id}/{ObjectType}/{object_pk}/telemetry. Frozen: see README.md in this directory for the rules of change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts"],
  "properties": {
    "ts": {
      "description": "When the reading was taken, RFC 3339 with a T, seconds, at most six fractional digits and an explicit offset. The pattern checks form only; the instant must also exist (no 30 February).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "metrics": {
      "description": "Readings by name. A boolean is stored as 1 or 0, a string as a label.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,62}$" },
      "additionalProperties": { "type": ["number", "boolean", "string"] }
    },
    "position": {
      "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }]
    },
    "seq": {
      "description": "A per-source counter. Optional, and not used for ordering or de-duplication.",
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    }
  },
  "anyOf": [
    { "required": ["metrics"], "properties": { "metrics": { "minProperties": 1 } } },
    { "required": ["position"], "properties": { "position": { "$ref": "#/$defs/position" } } }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "alt_m": { "type": ["number", "null"] },
        "heading_deg": {
          "anyOf": [{ "type": "number", "minimum": 0, "exclusiveMaximum": 360 }, { "type": "null" }]
        },
        "speed_mps": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }
      }
    }
  }
}
