# Copy to .env (git-ignored) to override the local stack's defaults.
# Docker Compose reads deploy/docker-compose/.env automatically.

# --- credentials (local development only) ---
POSTGRES_PASSWORD=postgres_dev
S2_APP_DB_PASSWORD=s2_app_dev
KEYCLOAK_ADMIN_PASSWORD=admin_dev

# --- image versions ---
S2_PG_IMAGE=timescale/timescaledb-ha:pg18-ts2.30
SEAWEEDFS_VERSION=4.48
MOSQUITTO_VERSION=2
KAFKA_VERSION=4.4.0
KEYCLOAK_VERSION=26.8.2
OPA_VERSION=1.20.2

# --- services ---
S2_LOG_LEVEL=INFO

# --- telemetry simulator (make sim) ---
S2_SIM_FLEET=3
S2_SIM_ROBOTS=1
S2_SIM_RATE_HZ=1
